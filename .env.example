# Required
OPENAI_API_KEYS = gsk_key1, gsk_key2
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
OPENAI_MODEL = "qwen/qwen3-32b"
JWT_SECRET = "change-this-to-a-random-secret"

# Optional (have defaults)
# Local development: use the Postgres container from docker-compose
# (`docker compose up -d postgres`) or your own local PostgreSQL instance.
# Percent-encode reserved characters if your password contains them.
POSTGRES_URL = "postgresql://devdocs:devdocs@localhost:5432/devdocs"
# Docker Compose database settings (also used to build the backend URL)
POSTGRES_USER = "devdocs"
POSTGRES_PASSWORD = "devdocs"
POSTGRES_DB = "devdocs"
# Host port for the bundled Postgres container (loopback only)
POSTGRES_PORT = "5432"
JWT_EXPIRE_IN_MINUTES = 15
JWT_ALGORITHM = "HS256"
AGENTOPS_API_KEY = ""
ALLOW_ORIGINS = "*"

# Voice mode (optional — leave blank to disable voice)
# LiveKit Cloud project: https://cloud.livekit.io
LIVEKIT_URL = ""
LIVEKIT_API_KEY = ""
LIVEKIT_API_SECRET = ""
# Deepgram is used for both speech-to-text and text-to-speech
DEEPGRAM_API_KEY = ""
VOICE_AGENT_NAME = "devdocs-voice"
VOICE_LLM_MODEL = "google/gemma-4-31b-it"
VOICE_STT_MODEL = "flux-general-en"
VOICE_TTS_MODEL = "aura-2-thalia-en"
VOICE_KEYTERMS = "DevDocs,Agno,FastAPI,PostgreSQL,LiveKit,Deepgram"
